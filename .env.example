# Core
PROJECT_NAME=Clinic App
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
SECRET_KEY=change-me-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# Database
DATABASE_URL=postgresql+psycopg2://clinic:clinic@db:5432/clinic

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clinic.app
SMTP_TLS=True
PUBLIC_FRONTEND_URL=http://localhost:5173

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Telemedicine (Jitsi default; replace with your provider)
TELEMEDICINE_BASE_URL=https://meet.jit.si

# Observability
SENTRY_DSN=

# Rate limiting
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_DEFAULT=120/minute

# Bootstrap
FIRST_ADMIN_EMAIL=admin@clinic.app
FIRST_ADMIN_PASSWORD=Admin1234!

# 2FA / signed links
TWO_FA_ISSUER=Clinic App
SIGNED_LINK_SECRET=change-me-different-from-secret-key
SIGNED_LINK_TTL_DAYS=7

# WhatsApp (Twilio sandbox or approved sender)
TWILIO_WHATSAPP_FROM=

# No-show policy
NO_SHOW_GRACE_MINUTES=20
NO_SHOW_FEE=0
NO_SHOW_BLOCK_THRESHOLD=3

# Branding defaults (used if no row in DB)
BRAND_NAME=Clinic App
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR=#2563eb
BRAND_SUPPORT_EMAIL=
